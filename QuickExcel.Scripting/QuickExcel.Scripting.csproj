<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="smoke\**\*.cs" />
    <None Include="native\bin\quickexcel-js.dll" Link="quickexcel-js.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="native\QUICKJS-LICENSE.txt" Link="QUICKJS-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildQuickJsNative" BeforeTargets="PrepareForBuild" Condition="'$(OS)' == 'Windows_NT' and !Exists('$(MSBuildProjectDirectory)\native\bin\quickexcel-js.dll')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\native\build.ps1&quot;" />
  </Target>
</Project>
