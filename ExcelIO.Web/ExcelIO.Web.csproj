<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmStripILAfterAOT>true</WasmStripILAfterAOT>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ExcelIO.NetStandard\ExcelIO.NetStandard.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\ExcelIO.Formula\Ast.cs" />
    <Compile Include="..\ExcelIO.Formula\Biff8FormulaReader.cs" />
    <Compile Include="..\ExcelIO.Formula\BuiltinFunctions.cs" />
    <Compile Include="..\ExcelIO.Formula\DependencyGraph.cs" />
    <Compile Include="..\ExcelIO.Formula\FormulaEngine.cs" />
    <Compile Include="..\ExcelIO.Formula\FormulaEvaluator.cs" />
    <Compile Include="..\ExcelIO.Formula\FormulaParser.cs" />
    <Compile Include="..\ExcelIO.Formula\FunctionRegistry.cs" />
  </ItemGroup>
</Project>
