<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>ExcelIO.Formula</RootNamespace>
        <Version>1.0.0</Version>
        <Authors>Lovespite</Authors>
        <Company>Lovespite</Company>
        <Description>Pluggable formula calculation engine for ExcelIO</Description>
        <PackageTags>Excel;Formula;Calculation;ExcelIO</PackageTags>
        <PackageProjectUrl>https://github.com/lovespite/ExcelIO</PackageProjectUrl>
        <RepositoryUrl>https://github.com/lovespite/ExcelIO.git</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\ExcelIO\ExcelIO.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
